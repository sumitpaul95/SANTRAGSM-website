# Redirect everything to https://www.santragsm.paulsumit.com/
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Let’s Encrypt HTTP-01 challenge must not redirect
  RewriteCond %{REQUEST_URI} ^/\.well-known/acme-challenge/ [NC]
  RewriteRule - - [L]

  # If not HTTPS OR not the www host → redirect
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.santragsm\.paulsumit\.com$ [NC]
  RewriteRule ^ https://www.santragsm.paulsumit.com%{REQUEST_URI} [R=301,L]
</IfModule>
